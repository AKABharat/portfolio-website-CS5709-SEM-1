<%- include('partials/header') %>

<div class="max-w-2xl mx-auto px-10 mt-12 mb-20">

  <a href="/blog" class="inline-block border-2 border-black rounded-xl px-4 py-2 font-bold mb-8 hover:bg-black hover:text-white transition-colors">
    ← Back to Blog
  </a>

  <div class="text-5xl font-bold mb-8">Write a Post ✍️</div>

  <% if (error) { %>
    <div class="bg-red-100 text-red-700 px-4 py-3 rounded-lg mb-4"><%= error %></div>
  <% } %>

  <form action="/blog/new" method="POST" class="space-y-4">
    <input type="text" name="title" placeholder="Post title" required
      class="w-full border-2 border-black rounded-xl px-4 py-3 text-xl font-bold">
    <textarea name="content" placeholder="Write your post..." required rows="10"
      class="w-full border-2 border-black rounded-xl px-4 py-3"></textarea>
    <button type="submit"
      class="bg-black text-white px-6 py-3 rounded-xl border-green-500 border-[5px] font-bold">
      Publish
    </button>
  </form>
</div>

<%- include('partials/footer') %>
