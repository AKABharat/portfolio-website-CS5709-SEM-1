<%- include('partials/header') %>

<%
  // ---------- Icon helpers ----------
  // Devicon: coloured tech logos (open source)
  const dev = (name, variant = 'original') =>
    `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${name}/${name}-${variant}.svg`;
  // Simple Icons: single-colour brand logos, colour set in the URL
  const si = (slug, color = 'white') => `https://cdn.simpleicons.org/${slug}/${color}`;

  // ---------- Content ----------
  const info = [
    { label: 'Email', value: 'bharatcode20@gmail.com' },
    { label: 'Location', value: 'Limerick, Ireland' },
    { label: 'GitHub', value: 'github.com/AKABharat', href: 'https://github.com/AKABharat' },
    { label: 'LinkedIn', value: 'linkedin.com/in/bharatdoodi', href: 'https://linkedin.com/in/bharatdoodi' },
    { label: 'Languages', value: 'English, Hindi' }
  ];

  const hobbies = ['🚗 Car Sketching', '🎨 Creative Arts', '🎧 Tech Podcasts'];

  // icon: a URL (shows an image) or an emoji (shows text)
  // dark: true = black text (for light backgrounds)
  // invert: true = turn a dark logo white
  const skillGroups = [
    {
      title: '💻 Languages',
      skills: [
        { name: 'C', icon: dev('c'), bg: '#0569a8' },
        { name: 'C++', icon: dev('cplusplus'), bg: '#07558c' },
        { name: 'Python', icon: dev('python'), bg: '#3d7fb5' },
        { name: 'JavaScript', icon: dev('javascript'), bg: '#f7df1e', dark: true },
        { name: 'SQL', icon: '🗃️', bg: '#416f91' },
        { name: 'Apex', icon: si('salesforce'), bg: '#09a4d8' }
      ]
    },
    {
      title: '🌐 Web Development',
      skills: [
        { name: 'HTML5', icon: dev('html5'), bg: '#f06529' },
        { name: 'CSS3', icon: dev('css3'), bg: '#1572b6' },
        { name: 'Node.js', icon: dev('nodejs'), bg: '#43853d' },
        { name: 'Express.js', icon: dev('express'), bg: '#000000', invert: true },
        { name: 'EJS', icon: si('ejs'), bg: '#a91e50' },
        { name: 'React', icon: dev('react'), bg: '#61dafb', dark: true },
        { name: 'REST API', icon: '🔌', bg: '#ff6840' }
      ]
    },
    {
      title: '🗄️ Databases',
      skills: [
        { name: 'MySQL', icon: dev('mysql'), bg: '#416f91' },
        { name: 'MongoDB', icon: dev('mongodb'), bg: '#43a047' }
      ]
    },
    {
      title: '☁️ Salesforce',
      skills: [
        { name: 'Salesforce', icon: si('salesforce'), bg: '#09a4d8' },
        { name: 'SF Admin', icon: '🛡️', bg: '#09a4d8' },
        { name: 'Apex Dev', icon: '⚡', bg: '#09a4d8' }
      ]
    },
    {
      title: '📊 Data & Analysis',
      skills: [
        { name: 'Pandas', icon: dev('pandas'), bg: '#30178f' },
        { name: 'NumPy', icon: dev('numpy'), bg: '#073f51' },
        { name: 'Matplotlib', icon: dev('matplotlib'), bg: '#3977a9' },
        { name: 'Seaborn', icon: '📈', bg: '#526fa8' },
        { name: 'Power BI', icon: si('powerbi', 'black'), bg: '#f2c811', dark: true },
        { name: 'Excel', icon: si('microsoftexcel'), bg: '#217346' }
      ]
    },
    {
      title: '🧰 Tools & Concepts',
      skills: [
        { name: 'Postman', icon: dev('postman'), bg: '#ff6b3d' },
        { name: 'VS Code', icon: dev('vscode'), bg: '#087acc' },
        { name: 'Git', icon: dev('git'), bg: '#f05032' },
        { name: 'OOP', icon: '🧩', bg: '#ff4f1f' },
        { name: 'DSA', icon: '🌳', bg: '#8e2de2' },
        { name: 'Tkinter', icon: '🖼️', bg: '#416f91' }
      ]
    }
  ];
%>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(-3deg); }
    50% { transform: translateY(-12px) rotate(3deg); }
  }

  .rocket-float {
    animation: float 3s ease-in-out infinite;
    display: inline-block;
  }

  .skill-card {
    transition: transform 0.2s ease;
  }

  .skill-card:hover {
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .rocket-float,
    .skill-card {
      animation: none;
      transition: none;
    }
  }
</style>

<div class="w-full px-10 mt-12 mb-20">

  <!-- Page title -->
  <div class="flex justify-between items-center mb-12">
    <div class="text-6xl md:text-7xl font-bold">About Me 🙋‍♂️</div>
    <div class="text-8xl leading-none">
      <span class="rocket-float">🚀</span>
    </div>
  </div>

  <!-- Intro + Quick info -->
  <div class="flex flex-col lg:flex-row items-start gap-12 lg:gap-16">

    <!-- LEFT -->
    <div class="w-full lg:w-3/5">
      <p class="text-2xl font-light text-gray-700 mb-6">
        I'm Bharat — a Software Engineer who likes turning messy data and messy
        problems into things that actually work.
      </p>

      <p class="text-xl font-light text-gray-600 mb-6">
        Right now I'm doing my MSc in Software Engineering at the University of
        Limerick, Ireland. Before that, I spent my time building things across
        data analytics, backend development, and the occasional Salesforce
        rabbit hole — working with Python, SQL, Apex, and a fair bit of Excel
        wizardry along the way.
      </p>

      <p class="text-xl font-light text-gray-600 mb-6">
        I enjoy figuring out how software is actually used — not just how it's
        built. I like digging into why some products click with people and
        others don't, and I'm always down to build something small that solves a
        real problem.
      </p>

      <p class="text-xl font-light text-gray-600">
        These days I'm leaning further into AI and full-stack development —
        learning as I build, and building as I learn.
      </p>
    </div>

    <!-- RIGHT -->
    <div class="w-full lg:w-2/5">

      <div class="text-4xl font-bold mb-6">Quick Info</div>

      <div class="space-y-3 mb-10">
        <% info.forEach(row => { %>
          <div class="flex justify-between border-b-2 border-black pb-2 gap-5">
            <span class="font-bold"><%= row.label %></span>
            <% if (row.href) { %>
              <a href="<%= row.href %>" target="_blank" rel="noopener noreferrer"
                 class="text-gray-600 underline text-right"><%= row.value %></a>
            <% } else { %>
              <span class="text-gray-600 text-right break-all"><%= row.value %></span>
            <% } %>
          </div>
        <% }) %>
      </div>

      <div class="text-4xl font-bold mb-6">Outside of Code 🎨</div>

      <div class="flex flex-col gap-3">
        <% hobbies.forEach(hobby => { %>
          <span class="bg-black text-white text-center px-5 py-2 rounded-2xl border-2 border-green-500">
            <%= hobby %>
          </span>
        <% }) %>
      </div>

    </div>
  </div>

  <!-- Skills -->
  <div class="mt-20">

    <div class="text-5xl font-bold mb-10">Skills ⚙️</div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-10">
      <% skillGroups.forEach(group => { %>
        <div>
          <div class="text-2xl font-bold mb-4 pb-2 border-b-2 border-black">
            <%= group.title %>
          </div>

          <div class="flex flex-wrap gap-2">
            <% group.skills.forEach(skill => { %>
              <div class="skill-card inline-flex items-center gap-2 px-3 py-2 rounded-md <%= skill.dark ? 'text-black' : 'text-white' %>"
                   style="background-color: <%= skill.bg %>;">
                <% if (skill.icon.startsWith('http')) { %>
                  <img src="<%= skill.icon %>"
                       alt=""
                       class="w-5 h-5 <%= skill.invert ? 'brightness-0 invert' : '' %>"
                       onerror="this.style.display='none'">
                <% } else { %>
                  <span class="text-base leading-none"><%= skill.icon %></span>
                <% } %>
                <span class="font-bold tracking-widest text-sm uppercase"><%= skill.name %></span>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>

  </div>

</div>

<%- include('partials/footer') %>
