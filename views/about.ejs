<%- include('partials/header', {
  pageTitle: 'About Me',
  pageDesc: 'About Bharat, his background, interests and technical skills.',
  currentPath: '/about'
}) %>

<%
  // [label, value, optional link]
  const info = [
    ['Email', 'bharatcode20@gmail.com', 'mailto:bharatcode20@gmail.com'],
    ['Location', 'Limerick, Ireland'],
    ['GitHub', 'github.com/AKABharat', 'https://github.com/AKABharat'],
    ['LinkedIn', 'linkedin.com/in/bharatdoodi', 'https://linkedin.com/in/bharatdoodi'],
    ['Languages', 'English, Hindi']
  ];

  const hobbies = ['🚗 Car Sketching', '🎨 Creative Arts', '🎧 Tech Podcasts'];

  const skillGroups = [
    {"title":"💻 Languages","skills":["C","C++","Python","JavaScript","SQL","Apex"]},
    {"title":"🌐 Web Development","skills":["HTML5","CSS3","Node.js","Express.js","EJS","React","REST API"]},
    {"title":"🗄️ Databases","skills":["MySQL","MongoDB"]},
    {"title":"☁️ Salesforce","skills":["Salesforce","SF Admin","Apex Dev"]},
    {"title":"📊 Data & Analysis","skills":["Pandas","NumPy","Matplotlib","Seaborn","Power BI","Excel"]},
    {"title":"🧰 Tools & Concepts","skills":["Postman","VS Code","Git","OOP","DSA","Tkinter"]}
  ];

  // Chip colours rotate through 6 tones inside each group
  const tones = [
    'bg-sky-700 text-white',
    'bg-cyan-700 text-white',
    'bg-emerald-600 text-white',
    'bg-amber-500 text-black',
    'bg-red-800 text-white',
    'bg-purple-700 text-white'
  ];
%>

<div class="w-full py-12 sm:py-20">

  <!-- Title -->
  <div class="flex justify-between items-center mb-12 gap-4">
    <h1 class="page-title">About Me 🙋‍♂️</h1>
    <span aria-hidden="true" class="text-6xl md:text-8xl float-icon">🚀</span>
  </div>

  <!-- Intro + Quick info -->
  <div class="flex flex-col lg:flex-row items-start gap-12 lg:gap-16">

    <!-- Left -->
    <div class="w-full lg:w-3/5 text-xl font-light text-gray-600 space-y-6">
      <p class="text-2xl text-black/75">
        I'm Bharat — a Software Engineer who likes turning messy data and messy problems into things that actually work.
      </p>
      <p>
        Right now I'm doing my MSc in Software Engineering at the University of Limerick, Ireland. Before that, I spent my time building things across data analytics, backend development, and the occasional Salesforce rabbit hole — working with Python, SQL, Apex, and a fair bit of Excel wizardry along the way.
      </p>
      <p>
        I enjoy figuring out how software is actually used — not just how it's built. I like digging into why some products click with people and others don't, and I'm always down to build something small that solves a real problem.
      </p>
      <p>
        These days I'm leaning further into AI and full-stack development — learning as I build, and building as I learn.
      </p>
    </div>

    <!-- Right -->
    <div class="w-full lg:w-2/5">
      <h2 class="text-4xl font-bold mb-6">Quick Info</h2>

      <div class="space-y-3 mb-10">
        <% info.forEach(([label, value, href]) => { %>
          <div class="flex justify-between border-b-2 border-black pb-2 gap-5">
            <strong><%= label %></strong>
            <% if (href) { %>
              <a href="<%= href %>" <% if (href.startsWith('http')) { %>target="_blank"<% } %> rel="noopener noreferrer"
                 class="text-gray-600 underline text-right break-all"><%= value %></a>
            <% } else { %>
              <span class="text-gray-600 text-right break-all"><%= value %></span>
            <% } %>
          </div>
        <% }) %>
      </div>

      <h2 class="text-4xl font-bold mb-6">Outside of Code 🎨</h2>
      <div class="flex flex-col gap-3">
        <% hobbies.forEach(h => { %>
          <span class="bg-black text-white text-center px-5 py-2 rounded-2xl border-2 border-green-500"><%= h %></span>
        <% }) %>
      </div>
    </div>

  </div>

  <!-- Skills -->
  <section class="mt-20">
    <h2 class="text-5xl font-bold mb-10">Skills ⚙️</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-10">
      <% skillGroups.forEach(group => { %>
        <div>
          <h3 class="text-2xl font-bold mb-4 pb-2 border-b-2 border-black"><%= group.title %></h3>
          <div class="flex flex-wrap gap-2">
            <% group.skills.forEach((skill, i) => { %>
              <span class="inline-flex items-center px-3 py-2 rounded-md font-bold text-sm uppercase transition-transform hover:-translate-y-[3px] motion-reduce:transition-none motion-reduce:hover:transform-none <%= tones[i % 6] %>"><%= skill %></span>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

</div>

<%- include('partials/footer') %>
