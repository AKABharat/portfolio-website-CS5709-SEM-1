<%- include('partials/header') %>

<div class="max-w-md mx-auto mt-20 mb-20">
  <div class="text-5xl font-bold mb-8 text-center">Login 🔐</div>

  <% if (error) { %>
    <div class="bg-red-100 text-red-700 px-4 py-3 rounded-lg mb-4"><%= error %></div>
  <% } %>

  <form action="/login" method="POST" class="space-y-4">
    <input type="text" name="username" placeholder="Username" required
      class="w-full border-2 border-black rounded-xl px-4 py-3">
    <input type="password" name="password" placeholder="Password" required
      class="w-full border-2 border-black rounded-xl px-4 py-3">
    <button type="submit"
      class="w-full bg-black text-white py-3 rounded-xl border-green-500 border-5 font-bold">
      Login
    </button>
  </form>

  <p class="text-center text-gray-500 mt-6">
    Don't have an account? <a href="/signup" class="underline font-bold">Sign Up</a>
  </p>
</div>

<%- include('partials/footer') %>