<%- include('partials/header') %>

<div class="w-full px-10 mt-20 mb-20">

  <div class="flex flex-wrap justify-between items-center gap-4 mb-10">
    <div class="text-6xl font-bold">Blog ✍️</div>

    <% if (loggedIn) { %>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/blog/new" class="bg-black text-white px-5 py-3 rounded-xl font-bold">+ Write a Post</a>

        <!-- POST form so a stray link or prefetch can't log the user out -->
        <form action="/logout" method="POST">
          <button type="submit" class="px-5 py-3 rounded-xl border-2 border-black font-bold bg-red-600 text-white hover:bg-black hover:text-white transition-colors">Log out</button>
        </form>
      </div>
    <% } else { %>
      <a href="/login" class="text-gray-500 underline">Login to write a post</a>
    <% } %>
  </div>

  <% if (blogs.length === 0) { %>
    <p class="text-gray-500 text-xl">No posts yet. Be the first to write one!</p>
  <% } %>

  <div class="space-y-6">
    <% blogs.forEach(blog => { %>
      <a href="/blog/<%= blog._id %>" class="block border-2 border-black rounded-2xl p-6 hover:-translate-y-1 transition-transform">
        <div class="text-2xl font-bold"><%= blog.title %></div>
        <div class="text-gray-500 text-sm mt-1">
          By <%= blog.authorName %> · <%= blog.createdAt.toDateString() %>
        </div>
        <p class="text-gray-600 mt-3"><%= blog.content.substring(0, 150) %><%= blog.content.length > 150 ? '...' : '' %></p>
      </a>
    <% }) %>
  </div>

</div>

<%- include('partials/footer') %>
