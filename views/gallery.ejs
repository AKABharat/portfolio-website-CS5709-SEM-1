<%
  // Routes: /gallery and /gallery/pictures -> render('gallery')
  //         /gallery/videos               -> render('gallery', { initial: 'Videos' })
  const initialTab = (typeof initial !== 'undefined' && initial === 'Videos') ? 'Videos' : 'Photos';
%>
<%- include('partials/header', {
  pageTitle: initialTab === 'Videos' ? 'Gallery Videos' : 'Gallery Photos',
  pageDesc: 'Browse Bharat’s gallery of photos and videos.',
  currentPath: '/gallery'
}) %>

<%
  // photos and videos come from data/gallery-photos.json and
  // data/gallery-videos.json via page_controller.js
  const filters = ['All', 'University', 'Work', 'Personal'];

  // Shared button looks (the JS below swaps these when a button becomes active/inactive)
  const btnBase = 'inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm cursor-pointer transition-colors';
  const btnOn = 'bg-black text-white shadow hover:bg-black/90';
  const btnOff = 'bg-gray-200 text-gray-700 shadow-sm hover:bg-gray-200/80';
%>

<div class="w-full py-12 sm:py-20">

  <div class="text-center mb-10">
    <h1 class="text-5xl md:text-6xl font-bold mb-3">Gallery 🖼️</h1>
    <p class="text-gray-600 text-lg">Photos and videos, in one place.</p>
  </div>

  <!-- Photos / Videos tabs -->
  <div role="tablist" aria-label="Gallery media" class="flex justify-center gap-3 mb-10">
    <% ['Photos', 'Videos'].forEach(t => { %>
      <button type="button" role="tab" data-tab="<%= t %>" aria-selected="<%= initialTab === t %>"
        class="tab-btn h-auto px-6 py-3 rounded-full font-bold <%= btnBase %> <%= initialTab === t ? btnOn : btnOff %>"><%= t %></button>
    <% }) %>
  </div>

  <!-- PHOTOS -->
  <div id="photos-panel" class="<%= initialTab === 'Photos' ? '' : 'hidden' %>">

    <div class="flex justify-center gap-3 flex-wrap mb-10">
      <% filters.forEach(f => { %>
        <button type="button" data-filter="<%= f %>" aria-pressed="<%= f === 'All' %>"
          class="filter-btn h-9 rounded-full px-5 py-2 font-medium <%= btnBase %> <%= f === 'All' ? btnOn : btnOff %>"><%= f %></button>
      <% }) %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% photos.forEach((p, i) => { %>
        <button type="button" data-index="<%= i %>" data-category="<%= p.category %>" aria-label="View <%= p.label %>"
          class="photo-card group relative block h-64 w-full overflow-hidden rounded-2xl border-2 border-black p-0 cursor-pointer">
          <span class="absolute top-3 left-3 bg-white/90 text-black text-xs font-bold px-3 py-1 rounded-full z-10"><%= p.label %></span>
          <img src="<%= p.src %>" alt="<%= p.label %>" loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
        </button>
      <% }) %>
    </div>
  </div>

  <!-- VIDEOS -->
  <div id="videos-panel" class="max-w-4xl mx-auto <%= initialTab === 'Videos' ? '' : 'hidden' %>">

    <div class="rounded-2xl overflow-hidden border-2 border-black mb-6">
      <iframe id="video-player" class="w-full aspect-video" title="<%= videos[0].title %>"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-start gap-3 mb-10">
      <div>
        <h2 id="video-title" class="text-2xl font-bold"><%= videos[0].title %></h2>
        <p id="video-desc" class="text-gray-600 mt-1"><%= videos[0].desc %></p>
      </div>
      <span id="video-count" class="text-gray-600 text-sm whitespace-nowrap">Video 1 of <%= videos.length %></span>
    </div>

    <div class="space-y-4">
      <% videos.forEach((v, i) => { %>
        <button type="button" data-video="<%= i %>" aria-pressed="<%= i === 0 %>"
          class="video-item w-full flex justify-start gap-4 items-center p-3 rounded-xl border-2 border-black text-left cursor-pointer hover:bg-gray-100 transition-colors">
          <span class="bg-black text-white w-10 h-10 shrink-0 flex items-center justify-center rounded-lg font-bold"><%= i + 1 %></span>
          <span>
            <strong class="block"><%= v.title %></strong>
            <span class="text-gray-600 text-sm"><%= v.category %></span>
          </span>
        </button>
      <% }) %>
    </div>
  </div>

</div>

<!-- Photo lightbox -->
<div id="lightbox" role="presentation" class="hidden fixed inset-0 bg-black/80 items-center justify-center z-50 p-4 md:p-6">
  <div role="dialog" aria-modal="true" aria-label="Photo preview" class="bg-white rounded-2xl overflow-hidden max-w-2xl w-full relative">
    <button id="lightbox-close" type="button" aria-label="Close photo"
      class="absolute top-4 right-4 h-9 w-9 rounded-full z-10 bg-black text-white shadow hover:bg-black/90 cursor-pointer">✕</button>
    <img id="lightbox-img" src="" alt="" class="w-full max-h-[65vh] object-contain bg-gray-100">
    <div class="p-6">
      <span id="lightbox-tag" class="inline-block bg-black text-white text-xs font-bold px-3 py-1 rounded-full mb-3"></span>
      <p id="lightbox-caption" class="text-gray-600 text-lg"></p>
    </div>
  </div>
</div>

<script>
  (function () {
    const photos = <%- JSON.stringify(photos) %>;
    const videos = <%- JSON.stringify(videos) %>;
    const ON = '<%= btnOn %>'.split(' ');
    const OFF = '<%= btnOff %>'.split(' ');

    function setActive(btn, active) {
      btn.classList.remove(...(active ? OFF : ON));
      btn.classList.add(...(active ? ON : OFF));
    }

    /* ---------- Tabs ---------- */
    const tabs = document.querySelectorAll('.tab-btn');
    const photosPanel = document.getElementById('photos-panel');
    const videosPanel = document.getElementById('videos-panel');
    const player = document.getElementById('video-player');
    let currentVideo = 0;

    function loadVideo(i) {
      currentVideo = i;
      const v = videos[i];
      player.src = 'https://www.youtube.com/embed/' + v.id;
      player.title = v.title;
      document.getElementById('video-title').textContent = v.title;
      document.getElementById('video-desc').textContent = v.desc;
      document.getElementById('video-count').textContent = 'Video ' + (i + 1) + ' of ' + videos.length;
      document.querySelectorAll('.video-item').forEach((b, idx) =>
        b.setAttribute('aria-pressed', String(idx === i)));
    }

    function showTab(name) {
      const isVideos = name === 'Videos';
      photosPanel.classList.toggle('hidden', isVideos);
      videosPanel.classList.toggle('hidden', !isVideos);
      tabs.forEach(t => {
        const on = t.dataset.tab === name;
        t.setAttribute('aria-selected', String(on));
        setActive(t, on);
      });
      if (isVideos) loadVideo(currentVideo);   // load (or resume) the video only when needed
      else player.removeAttribute('src');      // stops playback when leaving Videos
    }

    tabs.forEach(t => t.addEventListener('click', () => showTab(t.dataset.tab)));
    if (<%= initialTab === 'Videos' %>) loadVideo(0);

    /* ---------- Playlist ---------- */
    document.querySelectorAll('.video-item').forEach(b =>
      b.addEventListener('click', () => loadVideo(Number(b.dataset.video))));

    /* ---------- Photo filter ---------- */
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.photo-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          const on = b === btn;
          b.setAttribute('aria-pressed', String(on));
          setActive(b, on);
        });
        const f = btn.dataset.filter;
        cards.forEach(c => c.classList.toggle('hidden', !(f === 'All' || c.dataset.category === f)));
      });
    });

    /* ---------- Lightbox ---------- */
    const lightbox = document.getElementById('lightbox');
    let lastFocus = null;

    function openLightbox(card) {
      const p = photos[Number(card.dataset.index)];
      lastFocus = card;
      document.getElementById('lightbox-img').src = p.src;
      document.getElementById('lightbox-img').alt = p.label;
      document.getElementById('lightbox-tag').textContent = p.label;
      document.getElementById('lightbox-caption').textContent = p.caption;
      lightbox.querySelector('[role="dialog"]').setAttribute('aria-label', p.label);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
      document.getElementById('lightbox-close').focus();
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
      if (lastFocus) lastFocus.focus();
    }

    cards.forEach(c => c.addEventListener('click', () => openLightbox(c)));
    document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', e => { if (e.target === lightbox) closeLightbox(); });
    window.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) closeLightbox();
    });
  })();
</script>

<%- include('partials/footer') %>
