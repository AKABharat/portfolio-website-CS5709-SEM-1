<%- include('partials/header', {
  pageTitle: 'Education',
  pageDesc: 'Bharat’s education and certifications in software engineering and data.',
  currentPath: '/education'
}) %>

<%
  // education and certifications come from data/education.json and
  // data/certifications.json via page_controller.js
%>

<div class="w-full py-12 sm:py-20">

  <div class="flex justify-between items-center mb-16 gap-4">
    <h1 class="page-title">Education 🎓</h1>
    <span aria-hidden="true" class="text-6xl md:text-[100px] float-icon">📚</span>
  </div>

  <!-- Degrees / schools -->
  <div class="space-y-10">
    <% education.forEach((e, i) => { %>
      <article class="flex flex-col sm:flex-row justify-between items-start gap-4 pb-8 <%= i < education.length - 1 ? 'border-b-2 border-black' : '' %>">
        <div>
          <h2 class="text-3xl font-bold"><%= e.title %></h2>
          <p class="text-xl text-gray-600 mt-1"><%= e.school %></p>
          <p class="text-lg font-light text-gray-600 mt-2"><%= e.subject %></p>
        </div>
        <div class="sm:text-right shrink-0">
          <div class="text-lg font-bold"><%= e.period %></div>
          <% if (e.grade) { %>
            <div class="font-bold text-gray-600 mt-2"><%= e.grade %></div>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>

  <!-- Certifications -->
  <section class="mt-16">
    <div class="flex flex-wrap justify-between items-center gap-3 mb-10">
      <h2 class="text-4xl md:text-6xl font-bold">Certifications 🏅</h2>
      <span class="text-gray-600 text-lg"><%= certifications.length %> earned</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% certifications.forEach(({ title, issuer, issued, credentialId, verifyUrl }) => { %>
        <article class="border-2 border-black rounded-2xl p-6 flex flex-col justify-between hover:-translate-y-1 hover:shadow-[6px_6px_0_0_#000] transition-all duration-200">
          <div>
            <div class="flex flex-wrap justify-between items-start gap-3 mb-3">
              <span class="inline-block bg-black text-white text-xs font-bold px-3 py-1 rounded-full"><%= issuer %></span>
              <span class="text-sm font-bold text-gray-600 whitespace-nowrap"><%= issued %></span>
            </div>
            <h3 class="text-2xl font-bold leading-snug"><%= title %></h3>
          </div>
          <div class="mt-5 pt-4 border-t border-gray-300 text-sm text-gray-600 flex flex-wrap justify-between items-center gap-2">
            <span class="break-all">ID: <%= credentialId %></span>
            <% if (verifyUrl) { %>
              <a href="<%= verifyUrl %>" target="_blank" rel="noopener noreferrer" class="font-bold text-black underline whitespace-nowrap">Verify ↗</a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

</div>

<%- include('partials/footer') %>
