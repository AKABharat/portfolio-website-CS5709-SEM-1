<%- include('partials/header') %>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(-3deg); }
    50% { transform: translateY(-15px) rotate(3deg); }
  }
  .cap-float {
    animation: float 3s ease-in-out infinite;
    display: inline-block;
  }
</style>

<div class="w-full px-10 mt-20 mb-20">

  <div class="flex justify-between items-center mb-16">
    <div class="text-7xl font-bold">Education 🎓</div>
    <div class="text-[100px]">
      <span class="cap-float">📚</span>
    </div>
  </div>

  <div class="space-y-10">

    <div class="flex justify-between items-start border-b-2 border-black pb-8">
      <div class="w-3/4">
        <div class="text-3xl font-bold">Bachelor of Technology</div>
        <div class="text-xl text-gray-600 mt-1">Swami Keshvanand Institute of Technology (SKIT), Jaipur</div>
        <div class="text-lg font-light text-gray-500 mt-2">Computer Science — Artificial Intelligence</div>
      </div>
      <div class="w-1/4 text-right">
        <div class="text-lg font-bold">2020 - 2024</div>
        <div class="font-bold text-gray-500 mt-2">CGPA 9.54</div>
      </div>
    </div>

    <div class="flex justify-between items-start border-b-2 border-black pb-8">
      <div class="w-3/4">
        <div class="text-3xl font-bold">Senior Secondary (12th)</div>
        <div class="text-xl text-gray-600 mt-1">Saint Verona Senior Secondary School, Jaipur</div>
        <div class="text-lg font-light text-gray-500 mt-2">Physics, Chemistry, Mathematics — RBSE Board</div>
      </div>
      <div class="w-1/4 text-right">
        <div class="text-lg font-bold">2020</div>
      </div>
    </div>

    <div class="flex justify-between items-start pb-8">
      <div class="w-3/4">
        <div class="text-3xl font-bold">Secondary (10th)</div>
        <div class="text-xl text-gray-600 mt-1">Maheshwari Public School, Jaipur</div>
        <div class="text-lg font-light text-gray-500 mt-2">CBSE Board</div>
      </div>
      <div class="w-1/4 text-right">
        <div class="text-lg font-bold">2018</div>
      </div>
    </div>

  </div>

  <!-- Certifications -->
  <%
    const certifications = [
      { title: 'Claude Code 101', issuer: 'Anthropic', issued: 'Apr 2026', id: 'ju8pr66rnkf7', url: '' },
      { title: 'Data Cloud Consultant', issuer: 'Salesforce', issued: 'Jan 2025', id: '5612540', url: '' },
      { title: 'AI Specialist', issuer: 'Salesforce', issued: 'Oct 2024', id: '5006252', url: '' },
      { title: 'AI Associate', issuer: 'Salesforce', issued: 'Oct 2024', id: '5005965', url: '' },
      { title: 'Front End Development', issuer: 'IBM', issued: 'Jul 2023', id: 'STU6461fbca16c2e1684143050', url: '' },
      { title: 'Certificate for Completion of Python 3 Training', issuer: 'Indian Institute of Technology, Bombay', issued: 'May 2023', id: '3022511XIL', url: '' },
      { title: 'Certificate for Completion of C++ Training', issuer: 'Indian Institute of Technology, Bombay', issued: 'Jan 2022', id: '30225118R1', url: '' }
    ];
  %>

  <div class="mt-16">
    <div class="flex justify-between items-center mb-10">
      <div class="text-6xl font-bold">Certifications 🏅</div>
      <div class="text-gray-500 text-lg"><%= certifications.length %> earned</div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% certifications.forEach(cert => { %>
        <div class="border-2 border-black rounded-2xl p-6 flex flex-col justify-between hover:-translate-y-1 hover:shadow-[6px_6px_0_0_#000] transition-all duration-200">
          <div>
            <div class="flex justify-between items-start gap-4 mb-3">
              <span class="inline-block bg-black text-white text-xs font-bold px-3 py-1 rounded-full">
                <%= cert.issuer %>
              </span>
              <span class="text-sm font-bold text-gray-500 whitespace-nowrap"><%= cert.issued %></span>
            </div>
            <div class="text-2xl font-bold leading-snug"><%= cert.title %></div>
          </div>

          <div class="mt-5 pt-4 border-t border-gray-300 flex justify-between items-center gap-4">
            <div class="text-sm text-gray-500 break-all">ID: <%= cert.id %></div>
            <% if (cert.url) { %>
              <a href="<%= cert.url %>" target="_blank" rel="noopener noreferrer"
                 class="text-sm font-bold whitespace-nowrap hover:underline">View ↗</a>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

</div>

<%- include('partials/footer') %>