│   │
│   └── partials/
│       ├── header.ejs
│       └── footer.ejs
│
└── ...
        </div>
    </div>


    <!-- SECTION 11: DEVELOPMENT -->
    <div class="readme-section">
        <h2>10. Development Iterations</h2>

        <h3>Iteration 1</h3>

        <p>
            The first development iteration focused on creating the main
