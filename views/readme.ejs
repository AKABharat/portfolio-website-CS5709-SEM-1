<%- include('partials/header') %>

<style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
            color: #222;
            line-height: 1.7;
        }

        .readme-container {
            width: 90%;
            max-width: 1100px;
            margin: 50px auto;
            background: #ffffff;
            padding: 45px;
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
        }

        .readme-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .readme-header h1 {
            font-size: 38px;
            margin-bottom: 10px;
        }

        .readme-header p {
            color: #666;
            font-size: 17px;
        }

        .readme-section {
            margin-bottom: 35px;
        }

        .readme-section h2 {
            font-size: 26px;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #e5e7eb;
        }

        .readme-section h3 {
            font-size: 20px;
            margin: 18px 0 8px;
        }

        .readme-section p {
            margin-bottom: 12px;
        }

        .readme-section ul {
            margin-left: 25px;
            margin-bottom: 15px;
        }

        .readme-section li {
            margin-bottom: 7px;
        }

        .phase-box {
            background: #f8fafc;
            border-left: 5px solid #2563eb;
            padding: 18px 20px;
            margin: 15px 0;
            border-radius: 8px;
        }

        .project-structure {
            background: #111827;
            color: #f9fafb;
            padding: 25px;
            border-radius: 10px;
            overflow-x: auto;
            font-family: Consolas, monospace;
            white-space: pre;
            line-height: 1.5;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        .info-table th,
        .info-table td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        .info-table th {
            background: #f3f4f6;
        }

        .score-box {
            background: #eef6ff;
            padding: 20px;
            border-radius: 10px;
            margin-top: 15px;
        }

        .github-button {
            display: inline-block;
            margin-top: 12px;
            padding: 12px 22px;
            background: #111827;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            transition: 0.3s;
        }

        .github-button:hover {
            background: #2563eb;
        }

        .back-button {
            display: inline-block;
            margin-top: 30px;
            padding: 12px 22px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            border-radius: 8px;
        }

        @media (max-width: 768px) {
            .readme-container {
                width: 94%;
                padding: 25px;
                margin: 25px auto;
            }

            .readme-header h1 {
                font-size: 30px;
            }

            .readme-section h2 {
                font-size: 22px;
            }
        }
    </style>
</head>

<body>

<div class="readme-container">

    <!-- SECTION 1: HEADER -->
    <div class="readme-header">
        <h1>README</h1>
        <p>CS5709 – Software Engineering Evolution | Digital Portfolio</p>
        <p><strong>Student:</strong> Bharat Doodi</p>
    </div>


    <!-- SECTION 2: PROJECT OVERVIEW -->
    <div class="readme-section">
        <h2>1. Project Overview</h2>

        <p>
            This digital portfolio was developed as part of the
            <strong>CS5709 – Software Engineering Evolution</strong>
            module.
        </p>

        <p>
            The portfolio demonstrates the application of software engineering
            principles through the development of a functional web application
            containing multiple pages, navigation, styling, routing,
            multimedia content, blog functionality and instant messaging.
        </p>
    </div>


    <!-- SECTION 3: ASSESSMENT -->
    <div class="readme-section">
        <h2>2. Assessment Information</h2>

        <table class="info-table">
            <tr>
