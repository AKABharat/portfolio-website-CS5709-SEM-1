<%- include('partials/header', {
  pageTitle: 'Projects',
  pageDesc: 'Selected software, data analytics and web development projects by Bharat.',
  currentPath: '/projects'
}) %>

<%
  // projects comes from data/projects.json via page_controller.js
  // tone = gradient used for the card banner
  const gradients = {
    'project-indigo': 'bg-gradient-to-br from-indigo-500 to-purple-700',
    'project-green': 'bg-gradient-to-br from-emerald-500 to-teal-600',
    'project-blue': 'bg-gradient-to-br from-sky-400 to-blue-600',
    'project-rose': 'bg-gradient-to-br from-rose-400 to-pink-500'
  };
  const allTags = [...new Set(projects.flatMap(p => p.tags))].sort();
  const chipOn = 'bg-black text-white';
  const chipOff = 'bg-gray-200 text-gray-700';
%>

<div class="w-full py-12 sm:py-20">

  <h1 class="page-title mb-10">Projects 🛠️</h1>

  <!-- Search + tag filter: enhances the server-rendered list below via
       GET /api/projects (see public/js/projects-search.js). Works without
       JS too, since all projects are already rendered server-side. -->
  <div class="mb-12 flex flex-col gap-4">
    <input type="search" id="project-search" placeholder="Search projects by name, description or tag..."
      aria-label="Search projects" autocomplete="off"
      class="w-full max-w-xl border-2 border-black rounded-xl px-4 py-3 focus-visible:outline-none">

    <div class="flex flex-wrap gap-2" id="project-tag-filters">
      <button type="button" data-tag="" aria-pressed="true" class="tag-filter-btn <%= chipOn %> text-sm px-4 py-2 rounded-full font-medium cursor-pointer">All</button>
      <% allTags.forEach(t => { %>
        <button type="button" data-tag="<%= t %>" aria-pressed="false" class="tag-filter-btn <%= chipOff %> text-sm px-4 py-2 rounded-full font-medium cursor-pointer"><%= t %></button>
      <% }) %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10" id="projects-grid">
    <% projects.forEach(p => { %>
      <article class="border-2 border-black rounded-2xl overflow-hidden hover:-translate-y-2 transition-transform">

        <div class="w-full h-56 flex items-center justify-center text-[100px] <%= gradients[p.tone] %>" aria-hidden="true"><%= p.icon %></div>

        <div class="p-6">
          <div class="flex flex-wrap justify-between items-start gap-3 mb-2">
            <h2 class="text-2xl font-bold"><%= p.title %></h2>
            <a href="<%= p.url %>" target="_blank" rel="noopener noreferrer"
               class="bg-black text-white text-sm px-3 py-1.5 rounded-lg flex items-center gap-1 hover:-translate-y-0.5 transition-transform whitespace-nowrap">Code ↗</a>
          </div>

          <!-- Innovation: live GitHub stats, fetched server-side per
               request (see services/github_service.js). Omitted entirely
               when the API call failed/was rate-limited, rather than
               showing a stale or fake number. -->
          <% if (p.stats) { %>
            <div class="flex items-center gap-4 text-sm text-gray-500 mb-3" title="Live from the GitHub API">
              <span>⭐ <%= p.stats.stars %></span>
              <span>🍴 <%= p.stats.forks %></span>
            </div>
          <% } %>

          <p class="text-gray-600 mb-4"><%= p.description %></p>

          <div class="flex flex-wrap gap-2">
            <% p.tags.forEach(t => { %>
              <span class="bg-black text-white text-xs px-3 py-1 rounded-full"><%= t %></span>
            <% }) %>
          </div>
        </div>

      </article>
    <% }) %>
  </div>

  <p id="projects-empty" class="hidden text-gray-500 text-xl mt-10">No projects match your search.</p>

</div>

<script src="/js/projects-search.js" defer></script>

<%- include('partials/footer') %>
