<%- include('partials/header', {
  pageTitle: 'Projects',
  pageDesc: 'Selected software, data analytics and web development projects by Bharat.',
  currentPath: '/projects'
}) %>

<%
  // tone = gradient used for the card banner
  const projects = [
    {"title":"RFM Analysis Dashboard","icon":"📊","tone":"project-indigo","url":"https://github.com/AKABharat/E-Commerce-Customer-Segmentation-using-RFM-Analysis","description":"E-commerce customer-based RFM (Recency, Frequency, Monetary) analysis with an interactive dashboard built in Power BI. Performed ETL on raw data to identify valuable and at-risk customers.","tags":["Python","Pandas","Excel","Power BI"]},
    {"title":"Real Estate Management","icon":"🏠","tone":"project-green","url":"https://github.com/AKABharat/Real-Estate-Management-System","description":"A Salesforce-based web application for managing and searching real estate properties — property search, user login/signup, email notifications, user dashboard, and property uploads.","tags":["Salesforce","LWC","Apex","SOQL"]},
    {"title":"GetWeather","icon":"⛅","tone":"project-blue","url":"https://github.com/AKABharat/GetWeather","description":"A weather search website that displays real-time weather based on city input, pulling live data from a public weather API.","tags":["HTML5","CSS","JavaScript","Weather API"]},
    {"title":"SnapQuest","icon":"📸","tone":"project-rose","url":"https://github.com/AKABharat/SnapQuest","description":"An image search website that allows users to search and dynamically view images based on input, powered by the Unsplash API.","tags":["JavaScript","HTML","CSS","Unsplash API"]}
  ];

  const gradients = {
    'project-indigo': 'bg-gradient-to-br from-indigo-500 to-purple-700',
    'project-green': 'bg-gradient-to-br from-emerald-500 to-teal-600',
    'project-blue': 'bg-gradient-to-br from-sky-400 to-blue-600',
    'project-rose': 'bg-gradient-to-br from-rose-400 to-pink-500'
  };
%>

<div class="w-full py-12 sm:py-20">

  <h1 class="page-title mb-16">Projects 🛠️</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    <% projects.forEach(p => { %>
      <article class="border-2 border-black rounded-2xl overflow-hidden hover:-translate-y-2 transition-transform">

        <div class="w-full h-56 flex items-center justify-center text-[100px] <%= gradients[p.tone] %>" aria-hidden="true"><%= p.icon %></div>

        <div class="p-6">
          <div class="flex flex-wrap justify-between items-start gap-3 mb-2">
            <h2 class="text-2xl font-bold"><%= p.title %></h2>
            <a href="<%= p.url %>" target="_blank" rel="noopener noreferrer"
               class="bg-black text-white text-sm px-3 py-1.5 rounded-lg flex items-center gap-1 hover:-translate-y-0.5 transition-transform whitespace-nowrap">Code ↗</a>
          </div>

          <p class="text-gray-600 mb-4"><%= p.description %></p>

          <div class="flex flex-wrap gap-2">
            <% p.tags.forEach(t => { %>
              <span class="bg-black text-white text-xs px-3 py-1 rounded-full"><%= t %></span>
            <% }) %>
          </div>
        </div>

      </article>
    <% }) %>
  </div>

</div>

<%- include('partials/footer') %>
