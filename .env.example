MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
SESSION_SECRET=replace-with-a-long-random-string
PORT=8000
NODE_ENV=development

# Optional: restricts /blog/new to this one username (any logged-in user
# can post if left unset, matching Phase 1 behaviour).
OWNER_USERNAME=

# Optional: a GitHub personal access token (no scopes needed, it only
# reads public repo metadata). Raises the Projects page's live GitHub
# stats from 60 requests/hour shared across everyone on the same
# outbound IP, to 5000/hour tied to this token. Create one at
# https://github.com/settings/tokens -> "Generate new token (classic)".
GITHUB_TOKEN=
